[Unit]
Description=gunicorn daemon for Kittygram
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/kittygram/backend/
ExecStart=/home/ubuntu/kittygram/backend/venv/bin/gunicorn --bind 0.0.0.0:8080 --workers 1 --timeout 120 kittygram_backend.wsgi:application

[Install]
WantedBy=multi-user.target
